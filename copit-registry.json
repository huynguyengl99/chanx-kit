{
  "version": 1,
  "name": "chanx-kit",
  "title": "ChanX Kit",
  "description": "Composable, copy-in WebSocket components for chanx.",
  "source": "github:huynguyengl99/chanx-kit",
  "homepage": "https://github.com/huynguyengl99/chanx-kit",
  "ecosystem": "python",
  "variants": [
    "django",
    "fastapi"
  ],
  "detect": {
    "django": {
      "packages": [
        "django",
        "channels"
      ]
    },
    "fastapi": {
      "packages": [
        "fastapi"
      ]
    }
  },
  "install": {
    "target": "ws_kits",
    "package_marker": "__init__.py",
    "exclude": [
      "kit.yaml",
      "__pycache__/**"
    ],
    "optional": {
      "tests": [
        "tests/**"
      ]
    }
  },
  "components": {
    "ag-ui": {
      "name": "ag-ui",
      "title": "AG-UI",
      "description": "Serve the AG-UI agent-user interaction protocol over a websocket, so any AG-UI frontend works unchanged. Provider-agnostic: yield events from any agent. Optionally broadcasts a run to every connection on its thread, replaying it to one that joins part-way through.",
      "tier": "core",
      "version": "0.6.0",
      "path": "kits/ag_ui",
      "tags": [
        "agent",
        "ag-ui",
        "protocol",
        "streaming"
      ],
      "authors": [
        "Huy Nguyen <ndhgl99@gmail.com>"
      ],
      "requires": [],
      "dependencies": [
        "chanx>=2.10.2,<3",
        "ag-ui-protocol>=0.1.19"
      ],
      "variants": {},
      "only_variants": [],
      "files": [
        "README.md",
        "__init__.py",
        "messages.py",
        "store.py",
        "topics.py"
      ],
      "optional": {
        "tests": {
          "include": [
            "tests/__init__.py",
            "tests/test_ag_ui.py"
          ],
          "requires": [
            "chanx-testing"
          ]
        }
      }
    },
    "audio-stream-in": {
      "name": "audio-stream-in",
      "title": "Audio stream in",
      "description": "Stream microphone audio in over the socket and get transcripts back, from any speech-to-text provider. Defines the transcriber contract; provider kits plug in a stream. Bounded streams, per-user limits, gap detection and watcher fan-out.",
      "tier": "core",
      "version": "0.1.0",
      "path": "kits/audio_stream_in",
      "tags": [
        "audio",
        "speech-to-text",
        "transcription",
        "streaming"
      ],
      "authors": [
        "Huy Nguyen <ndhgl99@gmail.com>"
      ],
      "requires": [
        "media-stream-in"
      ],
      "dependencies": [
        "chanx>=2.10.2,<3"
      ],
      "variants": {},
      "only_variants": [],
      "files": [
        "README.md",
        "__init__.py",
        "messages.py",
        "provider.py",
        "topics.py"
      ],
      "optional": {
        "tests": {
          "include": [
            "tests/__init__.py",
            "tests/contract.py",
            "tests/test_audio_stream_in.py"
          ],
          "requires": [
            "chanx-testing"
          ]
        }
      }
    },
    "audio-stream-out": {
      "name": "audio-stream-out",
      "title": "Audio stream out",
      "description": "Speak text to a session's listeners from any text-to-speech provider. Defines the synthesizer contract; provider kits plug in audio. Utterances queue in order, an interruption clears them, late joiners are replayed, and playback marks record what was actually heard.",
      "tier": "core",
      "version": "0.1.0",
      "path": "kits/audio_stream_out",
      "tags": [
        "audio",
        "text-to-speech",
        "synthesis",
        "streaming"
      ],
      "authors": [
        "Huy Nguyen <ndhgl99@gmail.com>"
      ],
