{
  "name": "chanx-kit-sandbox-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "gen": "cd ../.. && uv run --extra fastapi --group dev-fastapi python -m sandbox.asyncapi > sandbox/ui/asyncapi.json && cd sandbox/ui && chanx-codegen asyncapi.json -o src/generated",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@chanx-js/client": "^0.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@chanx-js/codegen": "^0.1.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
