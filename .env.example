# Copy to .env (git-ignored); the sandbox, its scripts and scripts/live_check.py read it.

# Redis lets another process reach the browser: `docker compose up -d` starts it.
# Leave it out to run on the in-memory layer, a single process.
REDIS_URL=redis://localhost:6399/0

# Real speech providers for the voice demos; empty means the keyless fake.
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
